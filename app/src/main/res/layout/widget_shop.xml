<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp"
    android:background="@drawable/widget_bg">
    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="🛒 Покупки" android:textSize="15sp" android:textStyle="bold" android:textColor="#4A3F6B"/>
    <TextView
        android:id="@+id/shop_text"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:textSize="13sp" android:textColor="#4A3F6B"/>
</LinearLayout>
